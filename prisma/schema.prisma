generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PAYMENT_REVIEW
  REFUND_PENDING
}

model Product {
  id            Int         @id @default(autoincrement())
  slug          String      @unique
  code          String      @unique
  name          String
  tagline       String
  description   String      @db.Text
  ingredients   String      @db.Text
  category      String
  volume        String
  price         Decimal?    @db.Decimal(10, 0)
  compareAtPrice Decimal?   @db.Decimal(10, 0)
  bundlePrices   Int[]       @default([])
  storeUrl      String?
  imageUrl      String?
  galleryUrls   String[]    @default([])
  koreaSalesNote String?
  stock         Int         @default(0)
  isFeatured    Boolean     @default(false)
  isActive      Boolean     @default(true)
  orderItems    OrderItem[]
  reviews       ProductReview[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([category, isActive])
  @@index([isFeatured, isActive])
}

model Order {
  id              Int         @id @default(autoincrement())
  orderNumber     String      @unique
  status          OrderStatus @default(PENDING)
  ownerId         String?
  storeId         String?
  reservationExpiresAt DateTime?
  nextPaymentCheckAt DateTime?
  inventoryReleasedAt DateTime?
  paymentIssue    String?
  carrier         String?
  trackingNumber  String?
  shippedAt       DateTime?
  refundRequestedAt DateTime?
  customerEmail   String
  recipientName   String
  phone           String
  postalCode      String
  address         String
  addressDetail   String?
  subtotal        Decimal     @db.Decimal(10, 0)
  shippingFee     Decimal     @default(0) @db.Decimal(10, 0)
  total           Decimal     @db.Decimal(10, 0)
  items           OrderItem[]
  reviews         ProductReview[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerEmail, createdAt])
  @@index([status, createdAt])
  @@index([ownerId, createdAt])
  @@index([status, nextPaymentCheckAt])
}

model PaymentWebhookEvent {
  id          String   @id
  paymentId   String
  type        String
  processedAt DateTime @default(now())
}

model OrderOperation {
  id         Int      @id @default(autoincrement())
  orderId    Int
  operatorId String
  action     String
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  orderId       Int
  productId     Int?
  productName   String
  unitPrice     Decimal  @db.Decimal(10, 0)
  lineTotal     Decimal? @db.Decimal(10, 0)
  quantity      Int
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model ProductReview {
  id        String   @id @default(uuid())
  productId Int
  orderId   Int
  ownerId   String
  rating    Int
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photo     ReviewPhoto?

  @@unique([productId, ownerId])
  @@index([productId, createdAt, id])
  @@index([orderId])
}

model ReviewPhoto {
  reviewId String @id
  image    Bytes
  width    Int
  height   Int
  review   ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}
